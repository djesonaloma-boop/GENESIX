rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isChatMember(chatId) {
      return signedIn() && request.auth.uid in
        get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    // Profils publics minimaux : ne jamais y stocker mot de passe ou données privées.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Réservation atomique des pseudos (document ID = pseudo en minuscules).
    match /usernames/{usernameId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && usernameId == usernameId.lower();
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 256
        && request.auth.uid in request.resource.data.members;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['groupName', 'lastMessage', 'lastMessageTime', 'updatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.type == 'texte';
        allow update, delete: if false;
      }
    }
  }
}
