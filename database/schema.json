{
  "app": "GENESIX",
  "version": "1.0.0",
  "author": "Jason Aloma 🇨🇩",
  "database": "Firebase Realtime Database",
  "tables": {
    "users": {
      "uid": "string - ID Firebase Auth",
      "firstName": "string",
      "lastName": "string",
      "username": "string - unique, sans espace",
      "username_lower": "string - pour recherche",
      "fullName": "string",
      "email": "string",
      "phone": "string - ex: +243...",
      "birthDate": "string - YYYY-MM-DD",
      "gender": "string - Homme / Femme",
      "country": "string - ex: RDC",
      "city": "string - ex: Kinshasa",
      "photoURL": "string - URL photo",
      "bio": "string",
      "followers": "number - 0 par défaut",
      "following": "number - 0 par défaut",
      "postsCount": "number - 0 par défaut",
      "verified": "boolean - false par défaut",
      "verificationCode": "string - 6 chiffres",
      "verificationExpires": "number - timestamp",
      "online": "boolean",
      "lastSeen": "number - timestamp",
      "createdAt": "string - ISO date"
    },
    "conversations": {
      "members": "object - { uid: true }",
      "type": "string - private | group",
      "name": "string - nom du groupe",
      "photo": "string - photo groupe",
      "lastMessage": "string",
      "time": "number - timestamp dernier message",
      "createdAt": "number",
      "unread": "object - { uid: nombre }",
      "favorites": "object - { uid: true }",
      "pinned": "object - { uid: true }",
      "archived": "object - { uid: true }"
    },
    "messages": {
      "senderId": "string - uid expéditeur",
      "text": "string",
      "type": "string - text | image | audio | video",
      "imageUrl": "string - si image",
      "time": "number - timestamp",
      "seen": "boolean"
    }
  },
  "indexes": {
    "users": ["username_lower", "email"],
    "conversations": ["time"],
    "messages": ["time"]
  }
}
